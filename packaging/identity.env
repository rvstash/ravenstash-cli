# Build and release identity of the Ravenstash CLI.
#
# The single source of the names used by packaging scripts, repository tooling,
# and workflows. Plain KEY=value lines without quoting or expansion: bash sources
# this file, Python reads it, and workflows append it to the job environment.
# rvs/identity.py holds the same values for the running CLI, and the test suite
# fails when the two files, the installers, or a workflow literal disagree.

# GitHub repository that owns the source and the signed release assets.
RAVENSTASH_CLI_REPOSITORY=rvstash/ravenstash-cli

# Python project, Debian package, and Nix package and profile element.
RAVENSTASH_CLI_PACKAGE=ravenstash-cli
# Stem of every release asset and of the root directory in a portable archive.
RAVENSTASH_CLI_ASSET_STEM=ravenstash-cli

# Public release storage: object keys live under the namespace in the bucket,
# which is served at the releases URL.
RAVENSTASH_CLI_STORAGE_BUCKET=ravenstash-cli-releases
RAVENSTASH_CLI_NAMESPACE=ravenstash
RAVENSTASH_CLI_RELEASES_URL=https://releases.ravenstash.com
RAVENSTASH_CLI_APT_URL=https://releases.ravenstash.com/ravenstash/apt
RAVENSTASH_CLI_CHANNELS_URL=https://releases.ravenstash.com/ravenstash/channels.json

# Pinned armored key, generated binary keyring, and APT client file names.
RAVENSTASH_CLI_SIGNING_KEY=ravenstash-cli.asc
RAVENSTASH_CLI_KEYRING=ravenstash-cli.gpg
RAVENSTASH_CLI_SOURCE_LIST=ravenstash-cli.list

# Receipt written beside the launcher of a portable installation.
RAVENSTASH_CLI_RECEIPT=ravenstash-cli-install.json

# Package-manager identifiers; each is completed by a release channel.
RAVENSTASH_CLI_HOMEBREW_CASK=ravenstash-cli
RAVENSTASH_CLI_WINGET_PACKAGE=Ravenstash.RavenstashCLI
